# ============================================================
# .htaccess - Fabi Felintro Trainer
# Performance: Cache, Compressão, MIME Types
# ============================================================

# ------------------------------
# MIME Types
# ------------------------------
<IfModule mod_mime.c>
    AddType image/webp                          .webp
    AddType image/svg+xml                       .svg
    AddType application/javascript              .js
    AddType text/css                            .css
    AddType application/font-woff               .woff
    AddType application/font-woff2              .woff2
    AddType video/mp4                           .mp4
</IfModule>

# ------------------------------
# GZIP / Deflate (compressão de texto)
# ------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/font-woff
    AddOutputFilterByType DEFLATE application/font-woff2
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
</IfModule>

# ------------------------------
# Cache-Control (Use ciclos de vida eficientes de cache)
# ------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML - curto (conteúdo pode mudar)
    ExpiresByType text/html                     "access plus 1 hour"

    # CSS e JavaScript - médio
    ExpiresByType text/css                      "access plus 1 year"
    ExpiresByType application/javascript        "access plus 1 year"

    # Imagens - longo
    ExpiresByType image/webp                    "access plus 1 year"
    ExpiresByType image/jpeg                    "access plus 1 year"
    ExpiresByType image/png                     "access plus 1 year"
    ExpiresByType image/gif                     "access plus 1 year"
    ExpiresByType image/svg+xml                 "access plus 1 year"
    ExpiresByType image/x-icon                  "access plus 1 year"

    # Fontes - longo
    ExpiresByType application/font-woff         "access plus 1 year"
    ExpiresByType application/font-woff2        "access plus 1 year"
    ExpiresByType font/woff                     "access plus 1 year"
    ExpiresByType font/woff2                    "access plus 1 year"

    # Vídeo
    ExpiresByType video/mp4                     "access plus 1 month"
</IfModule>

# Cache-Control headers explícitos
<IfModule mod_headers.c>
    # CSS e JS com hash/versão → imutável
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Imagens → 1 ano
    <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>

    # Fontes → 1 ano
    <FilesMatch "\.(woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Vídeos → 1 mês
    <FilesMatch "\.(mp4|webm)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # HTML → sem cache agressivo
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>

    # Segurança básica
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ------------------------------
# URLs amigáveis (Clean URLs)
# ------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redireciona a URL antiga /lombar.html para a URL limpa (301)
    RewriteCond %{THE_REQUEST} \s/+lombar\.html[\s?] [NC]
    RewriteRule ^ /protocolo-lombar [R=301,L]

    # Serve lombar.html no endereço /protocolo-lombar
    RewriteRule ^protocolo-lombar/?$ lombar.html [L]
</IfModule>

# ------------------------------
# Força HTTPS
# Hostinger: ative pelo painel hPanel → SSL → Force HTTPS
# Se preferir via .htaccess, descomente abaixo:
# ------------------------------
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} off
#     RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
